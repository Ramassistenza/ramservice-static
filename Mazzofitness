    function bindEvents() {
      document.getElementById("saveProfileBtn").addEventListener("click", saveProfile);
      document.getElementById("addWeightBtn").addEventListener("click", addWeightLog);
      document.getElementById("resetDataBtn").addEventListener("click", resetData);

      document.getElementById("quickTodayBtn").addEventListener("click", () => {
        state.selectedDayIndex = getCurrentProgramIndex();
        saveState();
        setView("allenamento");
        renderSelectedDay();
      });

      document.getElementById("goWorkoutBtn").addEventListener("click", () => {
        state.selectedDayIndex = getCurrentProgramIndex();
        saveState();
        setView("allenamento");
        renderSelectedDay();
      });

      document.getElementById("startTodayWorkoutBtn").addEventListener("click", () => {
        startWorkout(getTodayProgramDay());
      });

      document.getElementById("startSelectedDayBtn").addEventListener("click", () => {
        startWorkout(getSelectedProgramDay());
      });

      document.getElementById("prevDayBtn").addEventListener("click", () => {
        state.selectedDayIndex = Math.max(0, state.selectedDayIndex - 1);
        saveState();
        renderSelectedDay();
      });

      document.getElementById("nextDayBtn").addEventListener("click", () => {
        state.selectedDayIndex = Math.min(PROGRAM_DAYS.length - 1, state.selectedDayIndex + 1);
        saveState();
        renderSelectedDay();
      });

      document.getElementById("closeSessionBtn").addEventListener("click", closeSession);
    }

    function initialize() {
      initNav();
      initProgramTabs();
      bindEvents();

      if (!state.weightLogs.length) {
        state.weightLogs.push({ date: state.startDate, value: state.startWeight });
      }

      state.selectedDayIndex = getCurrentProgramIndex();
      saveState();
      updateDashboard();
    }

    initialize();
  </script>
</body>
</html>
