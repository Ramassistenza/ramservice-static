<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calistenica 28 Giorni - App</title>
  <style>
    :root{
      --bg:#0b1020;
      --bg2:#121933;
      --card:#171f3d;
      --card2:#1d2850;
      --text:#f3f6ff;
      --muted:#9fb0e0;
      --line:rgba(255,255,255,.08);
      --accent:#6ea8ff;
      --accent2:#7dffd6;
      --success:#35d07f;
      --warning:#ffbf47;
      --danger:#ff6b6b;
      --shadow:0 18px 40px rgba(0,0,0,.28);
      --radius:20px;
    }

    *{box-sizing:border-box}
    html,body{
      margin:0;
      padding:0;
      background:
        radial-gradient(circle at top left, rgba(110,168,255,.18), transparent 30%),
        radial-gradient(circle at top right, rgba(125,255,214,.12), transparent 20%),
        linear-gradient(180deg, var(--bg) 0%, #0f1730 100%);
      color:var(--text);
      font-family:Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      min-height:100%;
    }

    .app{
      width:min(1180px, 100%);
      margin:0 auto;
      padding:20px 14px 100px;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:18px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .logo{
      width:46px;
      height:46px;
      border-radius:14px;
      background:linear-gradient(135deg, var(--accent), var(--accent2));
      display:grid;
      place-items:center;
      color:#0c1730;
      font-size:24px;
      font-weight:800;
      box-shadow:var(--shadow);
    }

    h1,h2,h3,h4,p{margin:0}
    .subtitle{color:var(--muted); font-size:14px}

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    button, .btn{
      border:none;
      border-radius:14px;
      padding:12px 16px;
      font-weight:700;
      cursor:pointer;
      transition:.2s ease;
      box-shadow:var(--shadow);
    }

    .btn-primary{
      background:linear-gradient(135deg, var(--accent), #8bc0ff);
      color:#0a1630;
    }

    .btn-secondary{
      background:rgba(255,255,255,.08);
      color:var(--text);
      border:1px solid var(--line);
    }

    .btn-success{
      background:linear-gradient(135deg, var(--success), #7ff0a7);
      color:#082114;
    }

    .btn-danger{
      background:linear-gradient(135deg, var(--danger), #ff8d8d);
      color:#2b0c0c;
    }

    button:hover,.btn:hover{transform:translateY(-1px)}
    button:disabled{opacity:.5; cursor:not-allowed; transform:none}

    .grid{
      display:grid;
      grid-template-columns:1.15fr .85fr;
      gap:16px;
    }

    .card{
      background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.02));
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .card-header{
      padding:18px 18px 10px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }

    .card-body{
      padding:18px;
    }

    .hero{
      padding:18px;
      background:
        radial-gradient(circle at 90% 10%, rgba(125,255,214,.18), transparent 18%),
        radial-gradient(circle at 10% 0%, rgba(110,168,255,.18), transparent 25%),
        linear-gradient(135deg, #162149 0%, #101834 100%);
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:16px;
      align-items:center;
    }

    .hero h2{
      font-size:30px;
      line-height:1.05;
      margin-bottom:8px;
    }

    .hero p{
      color:var(--muted);
      line-height:1.5;
      margin-bottom:16px;
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:10px;
      margin-top:16px;
    }

    .stat{
      background:rgba(255,255,255,.05);
      border:1px solid var(--line);
      border-radius:16px;
      padding:14px;
    }

    .stat-label{
      font-size:12px;
      color:var(--muted);
      margin-bottom:6px;
    }

    .stat-value{
      font-size:22px;
      font-weight:800;
    }

    .progress-wrap{
      background:rgba(255,255,255,.08);
      border-radius:999px;
      height:12px;
      overflow:hidden;
      border:1px solid var(--line);
      margin-top:10px;
    }

    .progress-bar{
      height:100%;
      width:0%;
      background:linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius:999px;
      transition:width .35s ease;
    }

    .section-title{
      font-size:18px;
      font-weight:800;
    }

    .muted{color:var(--muted)}
    .small{font-size:13px}

    .form-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:12px;
    }

    .form-group{
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    label{
      font-size:13px;
      color:var(--muted);
      font-weight:600;
    }

    input, select{
      width:100%;
      border-radius:14px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.06);
      color:var(--text);
      padding:12px 14px;
      font-size:15px;
      outline:none;
    }

    input::placeholder{color:#8ea0d5}

    .tabs{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      margin-bottom:14px;
    }

    .tab{
      padding:10px 14px;
      border-radius:999px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.05);
      color:var(--text);
      font-weight:700;
      cursor:pointer;
    }

    .tab.active{
      background:linear-gradient(135deg, var(--accent), var(--accent2));
      color:#0a1630;
      border-color:transparent;
    }

    .day-list,.week-list,.month-list{
      display:grid;
      gap:10px;
    }

    .list-item{
      background:linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      border:1px solid var(--line);
      border-radius:16px;
      padding:14px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:6px 10px;
      border-radius:999px;
      background:rgba(255,255,255,.08);
      border:1px solid var(--line);
      font-size:12px;
      font-weight:800;
    }

    .badge.success{background:rgba(53,208,127,.14); color:#9ff1c2}
    .badge.warning{background:rgba(255,191,71,.14); color:#ffd88a}
    .badge.info{background:rgba(110,168,255,.14); color:#b7d2ff}

    .exercise-list{
      display:grid;
      gap:14px;
    }

    .exercise-card{
      border:1px solid var(--line);
      background:linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      border-radius:18px;
      overflow:hidden;
    }

    .exercise-inner{
      display:grid;
      grid-template-columns:180px 1fr;
      gap:0;
    }

    .exercise-figure{
      background:linear-gradient(180deg, #121b39, #0e1630);
      border-right:1px solid var(--line);
      min-height:170px;
      display:grid;
      place-items:center;
      padding:16px;
    }

    .exercise-content{
      padding:16px;
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .exercise-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:10px;
      flex-wrap:wrap;
    }

    .exercise-meta{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    .exercise-description{
      color:var(--muted);
      line-height:1.55;
    }

    .exercise-tips{
      padding-left:18px;
      margin:0;
      color:#d6defd;
    }

    .exercise-tips li{margin-bottom:6px}

    .exercise-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:6px;
    }

    .timeline{
      display:grid;
      gap:10px;
    }

    .timeline-item{
      border-left:3px solid rgba(110,168,255,.45);
      padding-left:12px;
    }

    .kpi{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:10px;
    }

    .kpi .box{
      background:rgba(255,255,255,.05);
      border:1px solid var(--line);
      border-radius:16px;
      padding:14px;
    }

    .weight-history{
      display:grid;
      gap:8px;
      max-height:260px;
      overflow:auto;
      padding-right:4px;
    }

    .weight-entry{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      background:rgba(255,255,255,.04);
      border:1px solid var(--line);
      border-radius:14px;
      padding:10px 12px;
    }

    .empty{
      text-align:center;
      padding:24px 14px;
      color:var(--muted);
      border:1px dashed var(--line);
      border-radius:16px;
      background:rgba(255,255,255,.03);
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:16px;
      width:min(720px, calc(100% - 24px));
      background:rgba(13,20,42,.88);
      backdrop-filter:blur(16px);
      border:1px solid var(--line);
      border-radius:22px;
      padding:10px;
      display:flex;
      justify-content:space-between;
      gap:8px;
      box-shadow:var(--shadow);
      z-index:60;
    }

    .nav-btn{
      flex:1;
      padding:12px;
      border-radius:16px;
      background:transparent;
      border:1px solid transparent;
      color:var(--muted);
      font-weight:800;
      cursor:pointer;
    }

    .nav-btn.active{
      color:var(--text);
      background:rgba(255,255,255,.07);
      border-color:var(--line);
    }

    .view{display:none}
    .view.active{display:block}

    .modal{
      position:fixed;
      inset:0;
      background:rgba(2,6,16,.75);
      backdrop-filter:blur(6px);
      display:none;
      align-items:center;
      justify-content:center;
      z-index:100;
      padding:16px;
    }

    .modal.show{display:flex}

    .modal-content{
      width:min(780px, 100%);
      max-height:92vh;
      overflow:auto;
      border-radius:24px;
      background:linear-gradient(180deg, #121b39, #0d1430);
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      position:relative;
    }

    .session-screen{
      padding:22px;
    }

    .session-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      margin-bottom:16px;
    }

    .session-main{
      display:grid;
      grid-template-columns:1fr;
      gap:18px;
    }

    .session-stage{
      text-align:center;
      padding:22px;
      border:1px solid var(--line);
      border-radius:22px;
      background:linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03));
    }

    .session-stage h2{
      font-size:28px;
      margin-bottom:6px;
    }

    .session-timer{
      font-size:64px;
      font-weight:900;
      letter-spacing:1px;
      margin:10px 0;
      color:#cfe1ff;
    }

    .series-progress{
      display:flex;
      justify-content:center;
      gap:8px;
      margin:12px 0;
      flex-wrap:wrap;
    }

    .dot{
      width:14px;
      height:14px;
      border-radius:999px;
      background:rgba(255,255,255,.12);
      border:1px solid var(--line);
    }

    .dot.done{background:var(--success)}
    .dot.current{background:var(--accent)}

    .session-actions{
      display:flex;
      justify-content:center;
      gap:10px;
      flex-wrap:wrap;
      margin-top:14px;
    }

    .count-box{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:12px;
      font-size:22px;
      font-weight:900;
      margin-top:12px;
      flex-wrap:wrap;
    }

    .count-pill{
      padding:14px 18px;
      border-radius:16px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.05);
      min-width:180px;
    }

    .session-sub{
      color:var(--muted);
      line-height:1.5;
      max-width:620px;
      margin:0 auto;
    }

    .session-footer{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      margin-top:16px;
      flex-wrap:wrap;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      padding:8px 12px;
      border-radius:999px;
      background:rgba(255,255,255,.07);
      border:1px solid var(--line);
      color:#dfe7ff;
      font-weight:700;
      font-size:13px;
    }

    .svg-wrap svg{
      width:100%;
      max-width:140px;
      height:auto;
      display:block;
    }

    .toast{
      position:fixed;
      top:18px;
      right:18px;
      min-width:240px;
      max-width:360px;
      background:#121b39;
      border:1px solid var(--line);
      color:var(--text);
      border-radius:18px;
      padding:14px 16px;
      box-shadow:var(--shadow);
      z-index:150;
      display:none;
    }

    .toast.show{display:block}

    @media (max-width: 980px){
      .grid,.hero-grid{grid-template-columns:1fr}
      .stats{grid-template-columns:repeat(2,1fr)}
      .form-grid{grid-template-columns:1fr}
    }

    @media (max-width: 720px){
      .exercise-inner{grid-template-columns:1fr}
      .exercise-figure{border-right:none; border-bottom:1px solid var(--line)}
      .stats{grid-template-columns:1fr 1fr}
      .session-timer{font-size:50px}
      .hero h2{font-size:24px}
    }

    @media (max-width: 520px){
      .stats{grid-template-columns:1fr}
      .topbar{align-items:flex-start; flex-direction:column}
    }
  </style>
</head>
<body>
  <div class="app">
    <div class="topbar">
      <div class="brand">
        <div class="logo">💪</div>
        <div>
          <h1>Calistenica 28 Giorni</h1>
          <div class="subtitle">App personale per dimagrimento, progressi e workout guidati</div>
        </div>
      </div>

      <div class="actions">
        <button class="btn-secondary" id="resetDataBtn">Reset dati</button>
        <button class="btn-primary" id="quickTodayBtn">Vai ad oggi</button>
      </div>
    </div>

    <div id="view-dashboard" class="view active">
      <div class="card hero">
        <div class="hero-grid">
          <div>
            <h2>Trasforma 28 giorni in una routine vera.</h2>
            <p>
              Inserisci il tuo peso iniziale, aggiorna il peso nel tempo e segui ogni giorno
              gli esercizi guidati con timer, ripetizioni, serie e riposo automatico.
            </p>

            <div class="form-grid">
              <div class="form-group">
                <label for="startWeight">Peso iniziale (kg)</label>
                <input type="number" id="startWeight" step="0.1" placeholder="Es. 89">
              </div>
              <div class="form-group">
                <label for="targetWeight">Peso obiettivo (kg)</label>
                <input type="number" id="targetWeight" step="0.1" placeholder="Es. 78">
              </div>
              <div class="form-group">
                <label for="startDate">Data inizio</label>
                <input type="date" id="startDate">
              </div>
            </div>

            <div class="exercise-actions" style="margin-top:14px">
              <button class="btn-primary" id="saveProfileBtn">Salva impostazioni</button>
              <button class="btn-secondary" id="goWorkoutBtn">Apri allenamento del giorno</button>
            </div>
          </div>

          <div class="card" style="background:rgba(255,255,255,.04)">
            <div class="card-body">
              <div class="section-title">Progresso obiettivo</div>
              <div class="small muted" style="margin-top:6px">Basato sull’ultimo peso registrato</div>
              <div class="progress-wrap">
                <div class="progress-bar" id="goalProgressBar"></div>
              </div>

              <div class="stats">
                <div class="stat">
                  <div class="stat-label">Peso iniziale</div>
                  <div class="stat-value" id="statStartWeight">--</div>
                </div>
                <div class="stat">
                  <div class="stat-label">Peso attuale</div>
                  <div class="stat-value" id="statCurrentWeight">--</div>
                </div>
                <div class="stat">
                  <div class="stat-label">Obiettivo</div>
                  <div class="stat-value" id="statTargetWeight">--</div>
                </div>
                <div class="stat">
                  <div class="stat-label">Mancano</div>
                  <div class="stat-value" id="statRemaining">--</div>
                </div>
              </div>

              <div style="margin-top:14px" class="kpi">
                <div class="box">
                  <div class="stat-label">Giorno corrente</div>
                  <div class="stat-value" id="statCurrentDay">Giorno 1</div>
                </div>
                <div class="box">
                  <div class="stat-label">Workout completati</div>
                  <div class="stat-value" id="statCompleted">0</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid" style="margin-top:16px">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="section-title">Allenamento di oggi</div>
              <div class="small muted" id="todaySubtitle">Preparazione del giorno in corso</div>
            </div>
            <button class="btn-success" id="startTodayWorkoutBtn">Avvia</button>
          </div>
          <div class="card-body">
            <div id="todayWorkoutSummary"></div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div>
              <div class="section-title">Aggiorna peso</div>
              <div class="small muted">Registra il peso per vedere il trend</div>
            </div>
          </div>
          <div class="card-body">
            <div class="form-grid" style="grid-template-columns:1fr 1fr auto">
              <div class="form-group">
                <label for="weightDate">Data</label>
                <input type="date" id="weightDate">
              </div>
              <div class="form-group">
                <label for="weightValue">Peso (kg)</label>
                <input type="number" id="weightValue" step="0.1" placeholder="Es. 88.4">
              </div>
              <div class="form-group" style="justify-content:flex-end">
                <label style="visibility:hidden">Salva</label>
                <button class="btn-primary" id="addWeightBtn">Aggiungi</button>
              </div>
            </div>

            <div style="margin-top:16px" class="weight-history" id="weightHistory"></div>
          </div>
        </div>
      </div>

      <div class="grid" style="margin-top:16px">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="section-title">Timeline programma</div>
              <div class="small muted">Mese, settimana e avanzamento</div>
            </div>
          </div>
          <div class="card-body">
            <div class="timeline" id="timelineSummary"></div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div>
              <div class="section-title">Come funziona</div>
              <div class="small muted">Uso rapido dell’app</div>
            </div>
          </div>
          <div class="card-body">
            <div class="timeline">
              <div class="timeline-item">
                <strong>1. Imposta il profilo</strong>
                <div class="muted small">Peso iniziale, obiettivo e data di partenza.</div>
              </div>
              <div class="timeline-item">
                <strong>2. Segui il giorno corrente</strong>
                <div class="muted small">L’app ti mostra automaticamente il workout del giorno.</div>
              </div>
              <div class="timeline-item">
                <strong>3. Avvia il workout guidato</strong>
                <div class="muted small">Timer, ripetizioni, serie, recupero e passaggio automatico.</div>
              </div>
              <div class="timeline-item">
                <strong>4. Aggiorna il peso</strong>
                <div class="muted small">Controlla se stai andando verso il tuo obiettivo.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="view-programma" class="view">
      <div class="card">
        <div class="card-header">
          <div>
            <div class="section-title">Programma completo</div>
            <div class="small muted">Naviga per mesi, settimane e giorni</div>
          </div>
        </div>
        <div class="card-body">
          <div class="tabs">
            <button class="tab active" data-program-tab="months">Mesi</button>
            <button class="tab" data-program-tab="weeks">Settimane</button>
            <button class="tab" data-program-tab="days">Giorni</button>
          </div>

          <div id="program-months" class="program-pane"></div>
          <div id="program-weeks" class="program-pane" style="display:none"></div>
          <div id="program-days" class="program-pane" style="display:none"></div>
        </div>
      </div>
    </div>

    <div id="view-allenamento" class="view">
      <div class="card">
        <div class="card-header">
          <div>
            <div class="section-title" id="dayViewTitle">Allenamento del giorno</div>
            <div class="small muted" id="dayViewSubtitle">Esercizi guidati della giornata</div>
          </div>
          <div class="actions">
            <button class="btn-secondary" id="prevDayBtn">Giorno precedente</button>
            <button class="btn-secondary" id="nextDayBtn">Giorno successivo</button>
            <button class="btn-success" id="startSelectedDayBtn">Avvia allenamento</button>
          </div>
        </div>
        <div class="card-body">
          <div id="selectedDayWorkout"></div>
        </div>
      </div>
    </div>

    <div id="view-progressi" class="view">
      <div class="grid">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="section-title">Progressi peso</div>
              <div class="small muted">Storico registrazioni</div>
            </div>
          </div>
          <div class="card-body">
            <div class="weight-history" id="weightHistoryLarge"></div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div>
              <div class="section-title">Statistiche</div>
              <div class="small muted">Situazione attuale</div>
            </div>
          </div>
          <div class="card-body">
            <div class="stats">
              <div class="stat">
                <div class="stat-label">Peso perso</div>
                <div class="stat-value" id="progressLost">--</div>
              </div>
              <div class="stat">
                <div class="stat-label">Media a settimana</div>
                <div class="stat-value" id="progressAvg">--</div>
              </div>
              <div class="stat">
                <div class="stat-label">Sessioni completate</div>
                <div class="stat-value" id="progressSessions">--</div>
