  </div>

  <div class="bottom-nav">
    <button class="nav-btn active" data-view="dashboard">Dashboard</button>
    <button class="nav-btn" data-view="programma">Programma</button>
    <button class="nav-btn" data-view="allenamento">Allenamento</button>
    <button class="nav-btn" data-view="progressi">Progressi</button>
  </div>

  <div class="modal" id="sessionModal">
    <div class="modal-content">
      <div class="session-screen">
        <div class="session-header">
          <div>
            <h2 id="sessionHeaderTitle">Workout guidato</h2>
            <div class="small muted" id="sessionHeaderSubtitle">Preparazione sessione</div>
          </div>
          <button class="btn-secondary" id="closeSessionBtn">Chiudi</button>
        </div>

        <div class="session-main">
          <div class="session-stage">
            <div id="sessionFigure" class="svg-wrap" style="display:flex; justify-content:center; margin-bottom:10px;"></div>
            <div class="pill" id="sessionStageLabel">Preparati</div>
            <h2 id="sessionExerciseName" style="margin-top:12px">Crunch</h2>
            <div class="session-sub" id="sessionExerciseDesc">Descrizione esercizio</div>

            <div class="series-progress" id="sessionSeriesDots"></div>

            <div class="session-timer" id="sessionTimer">00:00</div>

            <div class="count-box" id="repCounterBox" style="display:none">
              <div class="count-pill">
                Ripetizioni: <span id="repCurrent">0</span> / <span id="repTarget">0</span>
              </div>
            </div>

            <div class="session-actions" id="sessionActions"></div>

            <div class="session-footer">
              <div class="pill" id="sessionProgressText">Esercizio 1 di 1</div>
              <div class="pill" id="sessionSeriesText">Serie 1 di 1</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const STORAGE_KEY = "calistenica_app_v1";

    const DEFAULT_PROFILE = {
      startWeight: 89,
      targetWeight: 78,
      startDate: new Date().toISOString().slice(0,10),
      weightLogs: [],
      completedSessions: [],
      selectedDayIndex: 0
    };

    const EXERCISE_LIBRARY = {
      crunch: {
        name: "Crunch",
        type: "reps",
        description: "Addominali base per attivare il core e migliorare il controllo dell’addome.",
        tips: [
          "Mani dietro la testa senza tirare il collo",
          "Solleva solo le spalle",
          "Lombare aderente al pavimento",
          "Movimento lento e controllato"
        ]
      },
      mountain: {
        name: "Mountain Climbers",
        type: "time",
        description: "Esercizio dinamico che alza il battito e coinvolge addome, gambe e spalle.",
        tips: [
          "Posizione plank stabile",
          "Schiena dritta",
          "Ginocchia alternate verso il petto",
          "Addome sempre contratto"
        ]
      },
      plank: {
        name: "Plank",
        type: "time",
        description: "Isometria per rinforzare il core e stabilizzare il tronco.",
        tips: [
          "Gomiti sotto le spalle",
          "Corpo in linea",
          "Non inarcare la schiena",
          "Stringi addome e glutei"
        ]
      },
      legraise: {
        name: "Leg Raises",
        type: "reps",
        description: "Sollevamento gambe per addome basso e controllo del bacino.",
        tips: [
          "Schiena aderente a terra",
          "Gambe tese",
          "Non slanciare",
          "Scendi lentamente"
        ]
      },
      squat: {
        name: "Squat",
        type: "reps",
        description: "Fondamentale a corpo libero per gambe, glutei e dispendio calorico.",
        tips: [
          "Piedi larghezza spalle",
          "Scendi spingendo il bacino indietro",
          "Schiena neutra",
          "Ginocchia in linea con i piedi"
        ]
      },
      pushup: {
        name: "Push Up",
        type: "reps",
        description: "Piegamenti per petto, spalle, tricipiti e core.",
        tips: [
          "Corpo dritto",
          "Addome contratto",
          "Gomiti circa a 45°",
          "Scendi controllato"
        ]
      },
      burpee: {
        name: "Burpees",
        type: "reps",
        description: "Esercizio metabolico completo ad alta intensità.",
        tips: [
          "Vai in plank con controllo",
          "Ritorna in squat",
          "Salto esplosivo finale",
          "Mantieni ritmo regolare"
        ]
      },
      jumpingjack: {
        name: "Jumping Jack",
        type: "time",
        description: "Attivazione cardio e riscaldamento dinamico total body.",
        tips: [
          "Atterra morbido",
          "Mantieni il ritmo",
          "Braccia complete sopra la testa",
          "Respirazione regolare"
        ]
      },
      highknees: {
        name: "High Knees",
        type: "time",
        description: "Corsa sul posto a ginocchia alte per accelerare il metabolismo.",
        tips: [
          "Ginocchia alte",
          "Appoggi rapidi",
          "Core attivo",
          "Braccia coordinate"
        ]
      },
      bicycle: {
        name: "Crunch Bicicletta",
        type: "reps",
        description: "Variante addominale dinamica per obliqui e addome centrale.",
        tips: [
          "Gomito verso ginocchio opposto",
          "Non tirare il collo",
          "Movimento controllato",
          "Lombare stabile"
        ]
      },
      jumpsquat: {
        name: "Jump Squat",
        type: "reps",
        description: "Squat esplosivo per forza e consumo calorico.",
        tips: [
          "Atterraggio morbido",
          "Ginocchia stabili",
          "Salto esplosivo",
          "Controlla la discesa"
        ]
      },
      dynamicplank: {
        name: "Plank Dinamico",
        type: "time",
        description: "Plank con movimento per core, spalle e stabilità.",
        tips: [
          "Bacino fermo",
          "Alterna gomiti e mani",
          "Core sempre attivo",
          "Movimento pulito"
        ]
      },
      restwalk: {
        name: "Camminata veloce",
        type: "time",
        description: "Cardio leggero per recupero attivo e consumo grassi.",
        tips: [
          "Passo sostenuto",
          "Spalle rilassate",
          "Respira profondo",
          "Mantieni ritmo costante"
        ]
      }
    };

    function makeExercise(key, series, value, rest = 30) {
      const base = EXERCISE_LIBRARY[key];
      return {
        key,
        name: base.name,
        type: base.type,
        description: base.description,
        tips: base.tips,
        series,
        reps: base.type === "reps" ? value : null,
        seconds: base.type === "time" ? value : null,
        rest
      };
    }

    function dayPlan(dayNumber, weekIndex) {
      const phase = dayNumber <= 7 ? 1 : (dayNumber <= 14 ? 2 : (dayNumber <= 21 ? 3 : 4));
      const dayInWeek = ((dayNumber - 1) % 7) + 1;

      if (dayInWeek === 1) {
        return {
          title: "Allenamento A - Core + Brucia Grassi",
          focus: "Addome, cardio leggero, attivazione metabolica",
          exercises: phase === 1 ? [
            makeExercise("crunch", 3, 15, 25),
            makeExercise("mountain", 3, 25, 25),
            makeExercise("plank", 3, 25, 25),
            makeExercise("legraise", 3, 12, 30)
          ] : phase === 2 ? [
            makeExercise("crunch", 3, 20, 25),
            makeExercise("mountain", 3, 30, 25),
            makeExercise("plank", 3, 35, 25),
            makeExercise("legraise", 3, 15, 30)
          ] : phase === 3 ? [
            makeExercise("crunch", 4, 20, 20),
            makeExercise("mountain", 4, 35, 20),
            makeExercise("plank", 4, 40, 20),
            makeExercise("legraise", 4, 18, 25)
          ] : [
            makeExercise("crunch", 4, 25, 20),
            makeExercise("mountain", 4, 40, 20),
            makeExercise("plank", 4, 45, 20),
            makeExercise("legraise", 4, 20, 25)
          ]
        };
      }

      if (dayInWeek === 2) {
        return {
          title: "Cardio Metabolico",
          focus: "Battito, consumo calorico, accelerazione metabolismo",
          exercises: phase === 1 ? [
            makeExercise("jumpingjack", 3, 30, 20),
            makeExercise("highknees", 3, 20, 20),
            makeExercise("mountain", 3, 20, 25),
            makeExercise("restwalk", 1, 600, 0)
          ] : phase === 2 ? [
            makeExercise("jumpingjack", 4, 30, 20),
            makeExercise("highknees", 4, 25, 20),
            makeExercise("mountain", 4, 25, 20),
            makeExercise("restwalk", 1, 720, 0)
          ] : phase === 3 ? [
            makeExercise("jumpingjack", 4, 35, 15),
            makeExercise("highknees", 4, 30, 15),
            makeExercise("mountain", 4, 30, 20),
            makeExercise("burpee", 3, 8, 30)
          ] : [
            makeExercise("jumpingjack", 4, 40, 15),
            makeExercise("highknees", 4, 35, 15),
            makeExercise("mountain", 4, 35, 20),
            makeExercise("burpee", 4, 10, 30)
          ]
        };
      }

      if (dayInWeek === 3) {
        return {
          title: "Allenamento B - Total Body",
          focus: "Gambe, petto, addome, consumo generale",
          exercises: phase === 1 ? [
            makeExercise("squat", 3, 15, 30),
            makeExercise("pushup", 3, 8, 35),
            makeExercise("plank", 3, 25, 25),
            makeExercise("burpee", 2, 6, 35)
          ] : phase === 2 ? [
            makeExercise("squat", 3, 18, 30),
            makeExercise("pushup", 3, 10, 35),
            makeExercise("plank", 3, 35, 25),
            makeExercise("burpee", 3, 8, 35)
          ] : phase === 3 ? [
            makeExercise("squat", 4, 20, 25),
            makeExercise("pushup", 4, 10, 30),
            makeExercise("plank", 4, 40, 20),
            makeExercise("burpee", 3, 10, 30)
          ] : [
            makeExercise("jumpsquat", 4, 15, 25),
            makeExercise("pushup", 4, 12, 30),
            makeExercise("dynamicplank", 4, 35, 20),
            makeExercise("burpee", 4, 12, 30)
          ]
        };
      }

      if (dayInWeek === 4) {
        return {
          title: "Recupero Attivo",
          focus: "Riduzione stress, recupero, mobilità e consumo leggero",
          exercises: [
            makeExercise("restwalk", 1, 1800, 0),
            makeExercise("plank", 2, phase >= 3 ? 30 : 20, 20)
          ]
        };
      }

      if (dayInWeek === 5) {
        return {
          title: "Richiamo Core + Gambe",
          focus: "Core, stabilità, richiamo metabolico",
          exercises: phase === 1 ? [
            makeExercise("crunch", 3, 15, 25),
            makeExercise("legraise", 3, 10, 30),
            makeExercise("squat", 3, 15, 30),
            makeExercise("mountain", 3, 20, 25)
          ] : phase === 2 ? [
            makeExercise("crunch", 3, 20, 20),
            makeExercise("legraise", 3, 12, 25),
            makeExercise("squat", 3, 18, 25),
            makeExercise("mountain", 3, 25, 20)
          ] : phase === 3 ? [
            makeExercise("bicycle", 4, 20, 20),
            makeExercise("legraise", 4, 15, 20),
            makeExercise("squat", 4, 20, 20),
            makeExercise("mountain", 4, 30, 20)
          ] : [
            makeExercise("bicycle", 4, 25, 20),
            makeExercise("legraise", 4, 18, 20),
            makeExercise("jumpsquat", 4, 15, 25),
            makeExercise("mountain", 4, 35, 20)
          ]
        };
      }

      if (dayInWeek === 6) {
        return {
          title: "HIIT Breve",
          focus: "Alta intensità controllata",
          exercises: phase === 1 ? [
            makeExercise("jumpingjack", 4, 25, 15),
            makeExercise("mountain", 4, 20, 15),
            makeExercise("highknees", 4, 20, 20)
          ] : phase === 2 ? [
            makeExercise("jumpingjack", 4, 30, 15),
            makeExercise("mountain", 4, 25, 15),
            makeExercise("highknees", 4, 25, 20),
            makeExercise("burpee", 2, 6, 30)
          ] : phase === 3 ? [
            makeExercise("jumpingjack", 5, 30, 15),
            makeExercise("mountain", 5, 30, 15),
            makeExercise("highknees", 5, 30, 15),
            makeExercise("burpee", 3, 8, 30)
          ] : [
            makeExercise("jumpingjack", 5, 35, 15),
            makeExercise("mountain", 5, 35, 15),
            makeExercise("highknees", 5, 35, 15),
            makeExercise("burpee", 4, 10, 30)
          ]
        };
      }

      return {
        title: "Riposo",
        focus: "Recupero completo",
        exercises: []
      };
    }

    function generateProgram(totalDays = 28) {
      const days = [];
      for (let i = 1; i <= totalDays; i++) {
        const weekIndex = Math.ceil(i / 7);
        const monthIndex = Math.ceil(i / 28);
        const plan = dayPlan(i, weekIndex);
        days.push({
          dayNumber: i,
          weekIndex,
          monthIndex,
          ...plan
        });
      }
      return days;
    }

    const PROGRAM_DAYS = generateProgram(84);

    let state = loadState();
    let session = null;
    let sessionInterval = null;

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) {
          const initial = structuredClone(DEFAULT_PROFILE);
          initial.weightLogs = [{
            date: initial.startDate,
            value: initial.startWeight
          }];
          return initial;
        }
        const parsed = JSON.parse(raw);
        if (!parsed.weightLogs || !parsed.weightLogs.length) {
          parsed.weightLogs = [{
            date: parsed.startDate || new Date().toISOString().slice(0,10),
            value: parsed.startWeight || 89
          }];
        }
        if (!parsed.completedSessions) parsed.completedSessions = [];
        if (typeof parsed.selectedDayIndex !== "number") parsed.selectedDayIndex = 0;
        return parsed;
      } catch {
        return structuredClone(DEFAULT_PROFILE);
      }
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    function showToast(message) {
      const el = document.getElementById("toast");
      el.textContent = message;
      el.classList.add("show");
      setTimeout(() => el.classList.remove("show"), 2200);
    }

    function formatKg(v) {
      if (v == null || Number.isNaN(v)) return "--";
      return `${Number(v).toFixed(1)} kg`;
    }

    function formatDateIT(dateStr) {
      const d = new Date(dateStr + "T00:00:00");
      return d.toLocaleDateString("it-IT", { day:"2-digit", month:"2-digit", year:"numeric" });
    }

    function getCurrentWeight() {
      const logs = [...state.weightLogs].sort((a,b)=> new Date(a.date) - new Date(b.date));
      return logs.length ? Number(logs[logs.length - 1].value) : Number(state.startWeight);
    }

    function daysSinceStart() {
      const start = new Date(state.startDate + "T00:00:00");
      const today = new Date();
      today.setHours(0,0,0,0);
      const diff = Math.floor((today - start) / 86400000);
      return diff;
    }

    function getCurrentProgramIndex() {
      const diff = daysSinceStart();
      if (diff < 0) return 0;
      if (diff >= PROGRAM_DAYS.length) return PROGRAM_DAYS.length - 1;
      return diff;
    }

    function getSelectedProgramDay() {
      return PROGRAM_DAYS[Math.max(0, Math.min(PROGRAM_DAYS.length - 1, state.selectedDayIndex || 0))];
    }

    function getTodayProgramDay() {
      return PROGRAM_DAYS[getCurrentProgramIndex()];
    }

    function getGoalProgressPercent() {
      const start = Number(state.startWeight);
      const target = Number(state.targetWeight);
      const current = getCurrentWeight();
      if (start === target) return 100;
      const total = Math.abs(start - target);
      const done = Math.abs(start - current);
      return Math.max(0, Math.min(100, (done / total) * 100));
    }

    function isDayCompleted(dayNumber) {
      return state.completedSessions.some(s => s.dayNumber === dayNumber);
    }

    function updateDashboard() {
      document.getElementById("startWeight").value = state.startWeight;
      document.getElementById("targetWeight").value = state.targetWeight;
      document.getElementById("startDate").value = state.startDate;
      document.getElementById("weightDate").value = new Date().toISOString().slice(0,10);

      const currentWeight = getCurrentWeight();
      const remaining = Math.max(0, currentWeight - Number(state.targetWeight));
      document.getElementById("statStartWeight").textContent = formatKg(state.startWeight);
      document.getElementById("statCurrentWeight").textContent = formatKg(currentWeight);
      document.getElementById("statTargetWeight").textContent = formatKg(state.targetWeight);
      document.getElementById("statRemaining").textContent = `${remaining.toFixed(1)} kg`;
      document.getElementById("statCurrentDay").textContent = `Giorno ${getCurrentProgramIndex() + 1}`;
      document.getElementById("statCompleted").textContent = state.completedSessions.length;

      document.getElementById("goalProgressBar").style.width = getGoalProgressPercent() + "%";

      renderTodaySummary();
      renderWeightHistory();
      renderTimeline();
      renderProgramViews();
      renderSelectedDay();
      renderProgressView();
    }

    function renderTodaySummary() {
      const day = getTodayProgramDay();
      document.getElementById("todaySubtitle").textContent = `Giorno ${day.dayNumber} • Settimana ${day.weekIndex} • ${day.title}`;
      const wrap = document.getElementById("todayWorkoutSummary");

      const completedBadge = isDayCompleted(day.dayNumber)
        ? `<span class="badge success">✅ Completato</span>`
        : `<span class="badge warning">⏳ Da fare</span>`;

      let html = `
        <div class="list-item" style="margin-bottom:14px">
          <div>
            <div style="font-weight:800">${day.title}</div>
            <div class="small muted" style="margin-top:4px">${day.focus}</div>
          </div>
          <div>${completedBadge}</div>
        </div>
      `;

      if (!day.exercises.length) {
        html += `<div class="empty">Giornata di riposo completo.</div>`;
      } else {
        html += `<div class="exercise-list">`;
        day.exercises.forEach(ex => {
          html += `
            <div class="list-item">
              <div>
                <div style="font-weight:800">${ex.name}</div>
                <div class="small muted" style="margin-top:4px">
                  ${ex.series} serie • ${ex.type === "reps" ? `${ex.reps} ripetizioni` : `${ex.seconds} secondi`} • riposo ${ex.rest}s
                </div>
              </div>
              <span class="badge info">${ex.type === "reps" ? "Ripetizioni" : "Timer"}</span>
            </div>
          `;
        });
        html += `</div>`;
      }

      wrap.innerHTML = html;
    }

    function renderWeightHistory() {
      const list = [...state.weightLogs].sort((a,b)=> new Date(b.date) - new Date(a.date));
      const targets = ["weightHistory", "weightHistoryLarge"];
      targets.forEach(id => {
        const wrap = document.getElementById(id);
        if (!wrap) return;
        if (!list.length) {
          wrap.innerHTML = `<div class="empty">Nessun peso registrato.</div>`;
          return;
        }
        wrap.innerHTML = list.map((item, index) => `
          <div class="weight-entry">
            <div>
              <div style="font-weight:800">${formatKg(item.value)}</div>
              <div class="small muted">${formatDateIT(item.date)}</div>
            </div>
            ${index !== list.length - 1 ? `<button class="btn-secondary small-btn" onclick="removeWeight('${item.date}')">Elimina</button>` : `<span class="badge info">iniziale</span>`}
          </div>
        `).join("");
      });
    }

    function renderTimeline() {
      const todayIndex = getCurrentProgramIndex();
      const currentWeek = Math.ceil((todayIndex + 1) / 7);
      const currentMonth = Math.ceil((todayIndex + 1) / 28);

      const monthEnd = Math.min(currentMonth * 28, PROGRAM_DAYS.length);
      const weekEnd = Math.min(currentWeek * 7, PROGRAM_DAYS.length);

      document.getElementById("timelineSummary").innerHTML = `
        <div class="timeline-item">
          <strong>Mese corrente: ${currentMonth}</strong>
          <div class="small muted">Giorni ${((currentMonth - 1) * 28) + 1} - ${monthEnd}</div>
        </div>
        <div class="timeline-item">
          <strong>Settimana corrente: ${currentWeek}</strong>
          <div class="small muted">Giorni ${((currentWeek - 1) * 7) + 1} - ${weekEnd}</div>
        </div>
        <div class="timeline-item">
          <strong>Oggi sei al giorno ${todayIndex + 1}</strong>
          <div class="small muted">Il piano totale dura ${PROGRAM_DAYS.length} giorni.</div>
        </div>
      `;
    }

    function renderProgramViews() {
      const monthWrap = document.getElementById("program-months");
      const weekWrap = document.getElementById("program-weeks");
      const dayWrap = document.getElementById("program-days");

      const totalMonths = Math.ceil(PROGRAM_DAYS.length / 28);
      let monthHtml = `<div class="month-list">`;
      for (let m = 1; m <= totalMonths; m++) {
        const start = (m - 1) * 28 + 1;
        const end = Math.min(m * 28, PROGRAM_DAYS.length);
        const completed = state.completedSessions.filter(s => s.dayNumber >= start && s.dayNumber <= end).length;
        monthHtml += `
          <div class="list-item">
            <div>
              <div style="font-weight:800">Mese ${m}</div>
              <div class="small muted">Giorni ${start} - ${end}</div>
            </div>
            <div class="badge info">${completed} completati</div>
          </div>
        `;
      }
      monthHtml += `</div>`;
      monthWrap.innerHTML = monthHtml;

      const totalWeeks = Math.ceil(PROGRAM_DAYS.length / 7);
      let weekHtml = `<div class="week-list">`;
      for (let w = 1; w <= totalWeeks; w++) {
        const start = (w - 1) * 7 + 1;
        const end = Math.min(w * 7, PROGRAM_DAYS.length);
        const completed = state.completedSessions.filter(s => s.dayNumber >= start && s.dayNumber <= end).length;
        weekHtml += `
          <div class="list-item">
            <div>
              <div style="font-weight:800">Settimana ${w}</div>
              <div class="small muted">Giorni ${start} - ${end}</div>
            </div>
            <div class="badge ${completed >= (end-start+1) ? "success" : "info"}">${completed}/${end-start+1}</div>
          </div>
        `;
      }
      weekHtml += `</div>`;
      weekWrap.innerHTML = weekHtml;

      let dayHtml = `<div class="day-list">`;
      PROGRAM_DAYS.forEach((d, i) => {
        const badge = isDayCompleted(d.dayNumber)
          ? `<span class="badge success">Completato</span>`
          : `<span class="badge warning">Da fare</span>`;
        dayHtml += `
          <div class="list-item" style="cursor:pointer" onclick="openDay(${i})">
            <div>
              <div style="font-weight:800">Giorno ${d.dayNumber} • ${d.title}</div>
              <div class="small muted">Settimana ${d.weekIndex} • ${d.focus}</div>
            </div>
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
              ${badge}
              <span class="badge info">${d.exercises.length} esercizi</span>
            </div>
          </div>
        `;
      });
      dayHtml += `</div>`;
      dayWrap.innerHTML = dayHtml;
    }

    function renderSelectedDay() {
      const day = getSelectedProgramDay();
      document.getElementById("dayViewTitle").textContent = `Giorno ${day.dayNumber} • ${day.title}`;
      document.getElementById("dayViewSubtitle").textContent = `Settimana ${day.weekIndex} • ${day.focus}`;

      const wrap = document.getElementById("selectedDayWorkout");
      if (!day.exercises.length) {
        wrap.innerHTML = `<div class="empty">Giornata di riposo completo.</div>`;
        return;
      }

      wrap.innerHTML = `
        <div class="exercise-list">
          ${day.exercises.map((ex, idx) => renderExerciseCard(ex, idx + 1)).join("")}
        </div>
      `;
    }

    function renderExerciseCard(ex, index) {
      return `
        <div class="exercise-card">
          <div class="exercise-inner">
            <div class="exercise-figure">
              ${exerciseSVG(ex.key)}
            </div>
            <div class="exercise-content">
              <div class="exercise-top">
                <div>
                  <div class="badge info">Esercizio ${index}</div>
                  <h3 style="margin-top:8px">${ex.name}</h3>
                </div>
                <div class="exercise-meta">
                  <span class="badge">${ex.series} serie</span>
                  <span class="badge">${ex.type === "reps" ? `${ex.reps} ripetizioni` : `${ex.seconds} sec`}</span>
                  <span class="badge">riposo ${ex.rest}s</span>
                </div>
              </div>

              <div class="exercise-description">${ex.description}</div>

              <ul class="exercise-tips">
                ${ex.tips.map(t => `<li>${t}</li>`).join("")}
              </ul>
            </div>
          </div>
        </div>
      `;
    }

    function renderProgressView() {
      const currentWeight = getCurrentWeight();
      const lost = Number(state.startWeight) - currentWeight;
      const start = new Date(state.startDate + "T00:00:00");
      const latestDate = state.weightLogs.length
        ? [...state.weightLogs].sort((a,b)=> new Date(b.date) - new Date(a.date))[0].date
        : state.startDate;
      const last = new Date(latestDate + "T00:00:00");
      const weeks = Math.max(1, Math.round((last - start) / 86400000 / 7));
      const avg = lost / weeks;

      document.getElementById("progressLost").textContent = `${lost.toFixed(1)} kg`;
      document.getElementById("progressAvg").textContent = `${avg.toFixed(2)} kg`;
      document.getElementById("progressSessions").textContent = state.completedSessions.length;
      document.getElementById("progressProgram").textContent = `${getCurrentProgramIndex() + 1}/${PROGRAM_DAYS.length}`;

      const goalDiff = currentWeight - Number(state.targetWeight);
      let message = [];
      if (goalDiff <= 0) {
        message.push("Hai raggiunto o superato il peso obiettivo.");
      } else if (goalDiff <= 2) {
        message.push("Sei molto vicino all’obiettivo finale.");
      } else {
        message.push(`Mancano circa ${goalDiff.toFixed(1)} kg per arrivare all’obiettivo.`);
      }

      if (avg > 0.8) {
        message.push("Stai perdendo peso velocemente. Controlla di recuperare bene.");
      } else if (avg > 0.3) {
        message.push("Il ritmo di discesa è buono e sostenibile.");
      } else {
        message.push("La discesa è lenta: valuta più costanza su allenamento, sonno e alimentazione.");
      }

      document.getElementById("goalInterpretation").innerHTML = `
        <div class="timeline-item"><strong>Interpretazione</strong><div class="small muted">${message[0]}</div></div>
        <div class="timeline-item"><strong>Ritmo</strong><div class="small muted">${message[1]}</div></div>
      `;
    }

    function openDay(index) {
      state.selectedDayIndex = index;
      saveState();
      setView("allenamento");
      renderSelectedDay();
      updateNav("allenamento");
    }

    window.openDay = openDay;

    function removeWeight(date) {
      state.weightLogs = state.weightLogs.filter(w => w.date !== date || w.date === state.startDate);
      if (!state.weightLogs.some(w => w.date === state.startDate)) {
        state.weightLogs.push({ date: state.startDate, value: state.startWeight });
      }
      saveState();
      updateDashboard();
      showToast("Peso eliminato");
    }
    window.removeWeight = removeWeight;

    function setView(name) {
      document.querySelectorAll(".view").forEach(v => v.classList.remove("active"));
      const target = document.getElementById(`view-${name}`);
      if (target) target.classList.add("active");
      updateNav(name);
    }

    function updateNav(name) {
      document.querySelectorAll(".nav-btn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.view === name);
      });
    }

    function initNav() {
      document.querySelectorAll(".nav-btn").forEach(btn => {
        btn.addEventListener("click", () => setView(btn.dataset.view));
      });
    }

    function initProgramTabs() {
      document.querySelectorAll("[data-program-tab]").forEach(tab => {
        tab.addEventListener("click", () => {
          document.querySelectorAll("[data-program-tab]").forEach(t => t.classList.remove("active"));
          tab.classList.add("active");
          const key = tab.dataset.programTab;
          document.getElementById("program-months").style.display = key === "months" ? "block" : "none";
          document.getElementById("program-weeks").style.display = key === "weeks" ? "block" : "none";
          document.getElementById("program-days").style.display = key === "days" ? "block" : "none";
        });
      });
    }

    function saveProfile() {
      const startWeight = parseFloat(document.getElementById("startWeight").value);
      const targetWeight = parseFloat(document.getElementById("targetWeight").value);
      const startDate = document.getElementById("startDate").value;

      if (!startWeight || !targetWeight || !startDate) {
        showToast("Compila tutti i campi del profilo");
        return;
      }

      state.startWeight = startWeight;
      state.targetWeight = targetWeight;
      state.startDate = startDate;

      const existingStart = state.weightLogs.find(w => w.date === startDate);
      if (!existingStart) {
        state.weightLogs.push({ date: startDate, value: startWeight });
      }

      saveState();
      updateDashboard();
      showToast("Impostazioni salvate");
    }

    function addWeightLog() {
      const date = document.getElementById("weightDate").value;
      const value = parseFloat(document.getElementById("weightValue").value);
      if (!date || !value) {
        showToast("Inserisci data e peso");
        return;
      }

      state.weightLogs = state.weightLogs.filter(w => w.date !== date);
      state.weightLogs.push({ date, value });
      state.weightLogs.sort((a,b)=> new Date(a.date) - new Date(b.date));
      saveState();
      document.getElementById("weightValue").value = "";
      updateDashboard();
      showToast("Peso salvato");
    }

    function resetData() {
      if (!confirm("Vuoi davvero cancellare tutti i dati salvati?")) return;
      localStorage.removeItem(STORAGE_KEY);
      state = loadState();
      updateDashboard();
      showToast("Dati resettati");
    }

    function formatSeconds(sec) {
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
    }

    function startWorkout(day) {
      if (!day.exercises.length) {
        showToast("Nessun esercizio per questa giornata");
        return;
      }

      session = {
        dayNumber: day.dayNumber,
        dayTitle: day.title,
        exercises: day.exercises,
        exerciseIndex: 0,
        seriesIndex: 1,
        repCount: 0,
        phase: "ready",
        timerRemaining: 10
      };

      document.getElementById("sessionModal").classList.add("show");
      renderSession();
      startTimerPhase(10, "ready");
    }

    function closeSession() {
      clearInterval(sessionInterval);
      sessionInterval = null;
      session = null;
      document.getElementById("sessionModal").classList.remove("show");
    }

    function renderSession() {
      if (!session) return;
      const ex = session.exercises[session.exerciseIndex];

      document.getElementById("sessionHeaderTitle").textContent = `Giorno ${session.dayNumber} • ${session.dayTitle}`;
      document.getElementById("sessionHeaderSubtitle").textContent = `Esercizio ${session.exerciseIndex + 1} di ${session.exercises.length}`;

      const stageLabel = document.getElementById("sessionStageLabel");
      const exName = document.getElementById("sessionExerciseName");
      const exDesc = document.getElementById("sessionExerciseDesc");
      const timer = document.getElementById("sessionTimer");
      const repBox = document.getElementById("repCounterBox");
      const repCurrent = document.getElementById("repCurrent");
      const repTarget = document.getElementById("repTarget");
      const actions = document.getElementById("sessionActions");
      const progressText = document.getElementById("sessionProgressText");
      const seriesText = document.getElementById("sessionSeriesText");
      const figure = document.getElementById("sessionFigure");

      figure.innerHTML = exerciseSVG(ex.key);

      exName.textContent = ex.name;
      exDesc.textContent = ex.description;
      progressText.textContent = `Esercizio ${session.exerciseIndex + 1} di ${session.exercises.length}`;
      seriesText.textContent = `Serie ${session.seriesIndex} di ${ex.series}`;

      const dots = [];
      for (let i = 1; i <= ex.series; i++) {
        let cls = "dot";
        if (i < session.seriesIndex) cls += " done";
        else if (i === session.seriesIndex) cls += " current";
        dots.push(`<div class="${cls}"></div>`);
      }
      document.getElementById("sessionSeriesDots").innerHTML = dots.join("");

      if (session.phase === "ready") {
        stageLabel.textContent = "Preparati";
        timer.textContent = formatSeconds(session.timerRemaining);
        repBox.style.display = "none";
        actions.innerHTML = `
          <button class="btn-secondary" onclick="skipSessionPhase()">Salta</button>
        `;
      }

      if (session.phase === "time") {
        stageLabel.textContent = "Timer attivo";
        timer.textContent = formatSeconds(session.timerRemaining);
        repBox.style.display = "none";
        actions.innerHTML = `
          <button class="btn-secondary" onclick="pauseResumeTimer()">Pausa/Riprendi</button>
          <button class="btn-secondary" onclick="skipSessionPhase()">Salta serie</button>
        `;
      }

      if (session.phase === "reps") {
        stageLabel.textContent = "Conta ripetizioni";
        timer.textContent = "--:--";
        repBox.style.display = "flex";
        repCurrent.textContent = session.repCount;
        repTarget.textContent = ex.reps;
        actions.innerHTML = `
          <button class="btn-secondary" onclick="decreaseRep()">-1</button>
          <button class="btn-primary" onclick="increaseRep()">+1 ripetizione</button>
          <button class="btn-success" onclick="completeRepSeries()">Completa serie</button>
        `;
      }

      if (session.phase === "rest") {
        stageLabel.textContent = "Riposo";
        timer.textContent = formatSeconds(session.timerRemaining);
        repBox.style.display = "none";
        actions.innerHTML = `
          <button class="btn-secondary" onclick="skipSessionPhase()">Salta riposo</button>
        `;
      }

      if (session.phase === "done") {
        stageLabel.textContent = "Completato";
        timer.textContent = "✅";
        repBox.style.display = "none";
        actions.innerHTML = `
          <button class="btn-success" onclick="finishSession()">Chiudi</button>
        `;
      }
    }

    function startTimerPhase(seconds, phase) {
      clearInterval(sessionInterval);
      session.phase = phase;
      session.timerRemaining = seconds;
      renderSession();

      sessionInterval = setInterval(() => {
        if (!session) return;
        session.timerRemaining--;
        renderSession();
        if (session.timerRemaining <= 0) {
          clearInterval(sessionInterval);
          sessionInterval = null;
          moveSessionForward();
        }
      }, 1000);
    }

    let timerPaused = false;
    function pauseResumeTimer() {
      if (!session) return;
      if (session.phase !== "time" && session.phase !== "rest" && session.phase !== "ready") return;

      if (timerPaused) {
        timerPaused = false;
        startTimerPhase(session.timerRemaining, session.phase);
      } else {
        timerPaused = true;
        clearInterval(sessionInterval);
        sessionInterval = null;
        showToast("Timer in pausa");
      }
    }
    window.pauseResumeTimer = pauseResumeTimer;

    function skipSessionPhase() {
      clearInterval(sessionInterval);
      sessionInterval = null;
      moveSessionForward(true);
    }
    window.skipSessionPhase = skipSessionPhase;

    function increaseRep() {
      if (!session) return;
      const ex = session.exercises[session.exerciseIndex];
      session.repCount = Math.min(ex.reps, session.repCount + 1);
      renderSession();
      if (session.repCount >= ex.reps) {
        showToast("Target raggiunto, completa la serie");
      }
    }
    window.increaseRep = increaseRep;

    function decreaseRep() {
      if (!session) return;
      session.repCount = Math.max(0, session.repCount - 1);
      renderSession();
    }
    window.decreaseRep = decreaseRep;

    function completeRepSeries() {
      if (!session) return;
      moveSessionForward();
    }
    window.completeRepSeries = completeRepSeries;

    function moveSessionForward(skipped = false) {
      if (!session) return;
      const ex = session.exercises[session.exerciseIndex];

      if (session.phase === "ready") {
        if (ex.type === "time") {
          startTimerPhase(ex.seconds, "time");
        } else {
          session.phase = "reps";
          session.repCount = 0;
          renderSession();
        }
        return;
      }

      if (session.phase === "time" || session.phase === "reps") {
        if (session.seriesIndex < ex.series) {
          session.seriesIndex++;
          session.repCount = 0;
          if (ex.rest > 0) {
            startTimerPhase(ex.rest, "rest");
          } else {
            session.phase = "ready";
            session.timerRemaining = 5;
            renderSession();
            startTimerPhase(5, "ready");
          }
        } else {
          if (session.exerciseIndex < session.exercises.length - 1) {
            session.exerciseIndex++;
            session.seriesIndex = 1;
            session.repCount = 0;
            startTimerPhase(8, "ready");
          } else {
            session.phase = "done";
            renderSession();
          }
        }
        return;
      }

      if (session.phase === "rest") {
        session.phase = "ready";
        session.timerRemaining = 5;
        renderSession();
        startTimerPhase(5, "ready");
      }
    }

    function finishSession() {
      if (!session) return;
      if (!state.completedSessions.some(s => s.dayNumber === session.dayNumber)) {
        state.completedSessions.push({
          dayNumber: session.dayNumber,
          completedAt: new Date().toISOString()
        });
      }
      saveState();
      updateDashboard();
      closeSession();
      showToast("Allenamento completato 🎉");
    }
    window.finishSession = finishSession;

